{
  "name": "neurolinks-control",
  "version": "1.2.5",
  "description": "CRM Gestión Neurolinks",
  "author": "Neurolinks",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "tw:build": "npx @tailwindcss/cli -i ./public/assets/css/input.css -o ./public/assets/css/styles.css",
    "tw:watch": "npx @tailwindcss/cli -i ./public/assets/css/input.css -o ./public/assets/css/styles.css --watch",
    "serve": "pnpm tw:build && pnpm build && pnpm start",
    "tunnel": "pnpm tw:build && pnpm build && node dev-tunnel.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.25",
    "sweetalert2-react-content": "^5.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16"
  }
}
